# ============================================================
#  AI Knowledge Base — .gitignore
#  原则：笔记正文进版本库，体积大的/可再生的/带密钥的一律排除。
#  注意：忽略规则对「已提交过」的文件无效，所以这份文件必须在
#        第一次 commit 之前就写好。
# ============================================================

# ---------- 模型权重 / 检查点（最大的坑） ----------
*.pt
*.pth
*.ckpt
*.safetensors
*.gguf
*.ggml
*.onnx
*.h5
*.pb
*.tflite
*.msgpack
*.model
*.weights

# ---------- 数据集 / 大文件 ----------
*.parquet
*.arrow
*.feather
*.jsonl
*.csv
*.tsv
*.sqlite
*.sqlite3
*.db
*.hdf5
*.h5
*.npz
*.npy
*.pkl
*.pickle

# 示例数据白名单：想提交的小样本放 examples/ 下即可
!examples/**/*.jsonl
!examples/**/*.csv
!examples/**/*.tsv

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
share/python-wheels/

# 虚拟环境
venv/
.venv/
env/
ENV/
.conda/
.python-version

# ---------- 测试 / 静态检查缓存 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------- Jupyter ----------
# 注意：.ipynb 本身要提交（笔记/实验都在里面），只排除检查点与配置残留
.ipynb_checkpoints/
*.nbconvert.ipynb

# ---------- 深度学习实验产物 ----------
# 训练中间结果体积大且可复现，不进仓库
runs/
wandb/
mlruns/
lightning_logs/
checkpoints/
outputs/
models/
cache/
*.log

# HuggingFace / Torch 本地缓存
.cache/huggingface/
.cache/torch/
.hf_home/

# ---------- 密钥与凭据（绝不能提交） ----------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
secrets/
credentials.json
service-account*.json
*.token

# ---------- 编辑器 / IDE ----------
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.swp
*.swo
*~

# ---------- 操作系统 ----------
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------- 临时文件 ----------
tmp/
temp/
.tmp/
*.tmp
*.bak
*.orig
*.rej

# ---------- 静态站点（VitePress） ----------
# 依赖与构建产物都不进版本库：前者能用 package-lock.json 重装，后者由 Actions 生成
node_modules/
.pnpm-store/
docs/.vitepress/dist/
docs/.vitepress/cache/

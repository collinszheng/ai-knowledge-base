# ============================================================
#  .gitattributes — 统一跨平台行为
#  目的：避免 Windows / macOS / Linux 协作时产生「整文件 diff」
# ============================================================

# 默认：自动识别文本文件，仓库内统一使用 LF
* text=auto eol=lf

# 明确标记为文本（保证 LF 归一化）
*.md   text eol=lf
*.txt  text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.cfg  text eol=lf
*.ini  text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf

# 明确标记为二进制（禁止换行符转换，禁止 diff）
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.svg  text eol=lf
*.pdf  binary
*.zip  binary
*.gz   binary
*.7z   binary
*.pptx binary
*.docx binary
*.xlsx binary
*.pt   binary
*.pth  binary
*.safetensors binary

# Jupyter Notebook：保留原有换行，GitHub 有专门的富文本 diff
*.ipynb -text -diff

# 语言统计：笔记类仓库，别让 GitHub 把它识别成「Python 项目」
*.md    linguist-documentation
*.ipynb linguist-documentation
docs/01-AI辅助工程/**   linguist-documentation
docs/02-工具与环境/**   linguist-documentation
docs/03-AI应用开发/**   linguist-documentation
docs/04-大模型原理/**   linguist-documentation
docs/05-AI基础/**       linguist-documentation
docs/06-论文笔记/**     linguist-documentation
docs/使用手册/**        linguist-documentation
docs/assets/**          linguist-documentation
